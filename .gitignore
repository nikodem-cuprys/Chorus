__pycache__/
*.pyc
*.log

# Prototype environments, caches and model weights: tens of GB, all re-creatable
.scratch/**/envs/
.scratch/**/hf-cache/
.scratch/**/uv-cache/
*.safetensors
*.pth
*.pt

# Generated audio, except the built-in Voices' clips
*.wav
!.scratch/chorus/prototypes/voice-library/library/*.wav
!backend/chorus/languages/*/voices/*.wav

# App build and run artefacts
.venv/
node_modules/
frontend/dist/
exports/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Root certificates of one machine (see certs/README.md)
certs/*.crt
